### MiniRappi - Backend Testing - 35 pruebas :> ###

# Variables del entorno
@baseUrl = http://localhost:5050
@contentType = application/json

### 1. Verificar que el servidor esté funcionando ###
GET {{baseUrl}}/
Content-Type: {{contentType}}

### 2. Obtener estadísticas iniciales ###
GET {{baseUrl}}/stats
Content-Type: {{contentType}}

### 3. Obtener todas las tiendas ###
GET {{baseUrl}}/tiendas
Content-Type: {{contentType}}

### 4. REGISTRO - Nuevo consumidor ###
POST {{baseUrl}}/usuarios/registro
Content-Type: {{contentType}}

{
    "username": "cliente1",
    "password": "123456",
    "nombre": "Juan Pérez",
    "email": "juan@email.com",
    "telefono": "3001234567"
}

### 5. LOGIN - Consumidor ###
POST {{baseUrl}}/usuarios/login
Content-Type: {{contentType}}

{
    "username": "cliente1",
    "password": "123456"
}

### 6. REGISTRO - Nueva tienda ###
POST {{baseUrl}}/tiendas/registro
Content-Type: {{contentType}}

{
    "username": "pizzeria_roma",
    "password": "123456",
    "nombre": "Pizzería Roma",
    "descripcion": "Las mejores pizzas italianas",
    "categoria": "Pizza",
    "direccion": "Calle 123 #45-67",
    "telefono": "3001234567",
    "horario": "12:00 PM - 10:00 PM"
}

### 7. LOGIN - Tienda ###
POST {{baseUrl}}/tiendas/login
Content-Type: {{contentType}}

{
    "username": "pizzeria_roma",
    "password": "123456"
}

### 8. REGISTRO - Nuevo repartidor ###
POST {{baseUrl}}/repartidores/registro
Content-Type: {{contentType}}

{
    "username": "repartidor1",
    "password": "123456",
    "nombre": "Carlos López",
    "telefono": "3001234567"
}

### 9. LOGIN - Repartidor ###
POST {{baseUrl}}/repartidores/login
Content-Type: {{contentType}}

{
    "username": "repartidor1",
    "password": "123456"
}

### 10. OBTENER PRODUCTOS DE UNA TIENDA ###
GET {{baseUrl}}/tiendas/1/productos
Content-Type: {{contentType}}

### 11. CREAR NUEVO PRODUCTO ###
POST {{baseUrl}}/tiendas/1/productos
Content-Type: {{contentType}}

{
    "nombre": "Pizza Margherita",
    "descripcion": "Pizza tradicional con tomate, mozzarella y albahaca",
    "precio": 25000,
    "categoria": "Pizza",
    "imagen": "https://images.unsplash.com/photo-1604382355076-af4b0eb60143?w=400&h=300&fit=crop",
    "tiempoPreparacion": "15 min"
}

### 12. CREAR OTRO PRODUCTO ###
POST {{baseUrl}}/tiendas/1/productos
Content-Type: {{contentType}}

{
    "nombre": "Pizza Pepperoni",
    "descripcion": "Pizza con pepperoni, queso y salsa de tomate",
    "precio": 28000,
    "categoria": "Pizza",
    "imagen": "https://images.unsplash.com/photo-1628840042765-356cda07504e?w=400&h=300&fit=crop",
    "tiempoPreparacion": "18 min"
}

### 13. VERIFICAR PRODUCTOS CREADOS ###
GET {{baseUrl}}/tiendas/1/productos
Content-Type: {{contentType}}

### 14. OBTENER TODOS LOS PEDIDOS ###
GET {{baseUrl}}/pedidos
Content-Type: {{contentType}}

### 15. CREAR NUEVO PEDIDO CON CARRITO ###
POST {{baseUrl}}/pedidos
Content-Type: {{contentType}}

{
    "usuarioId": 1,
    "tiendaId": 1,
    "productos": [
        {
            "productoId": 1,
            "cantidad": 2
        }
    ],
    "direccionEntrega": "Calle 78 #12-34, Bogotá",
    "metodoPago": "efectivo"
}

### 16. CREAR OTRO PEDIDO ###
POST {{baseUrl}}/pedidos
Content-Type: {{contentType}}

{
    "usuarioId": 1,
    "tiendaId": 1,
    "productos": [
        {
            "productoId": 2,
            "cantidad": 1
        }
    ],
    "direccionEntrega": "Carrera 15 #93-47, Bogotá",
    "metodoPago": "tarjeta"
}

### 17. VERIFICAR PEDIDOS CREADOS ###
GET {{baseUrl}}/pedidos
Content-Type: {{contentType}}

### 18. ACTUALIZAR ESTADO DEL PEDIDO (ACEPTAR) ###
PUT {{baseUrl}}/pedidos/1
Content-Type: {{contentType}}

{
    "estado": "aceptado",
    "repartidorId": 1
}

### 19. CAMBIAR ESTADO DE TIENDA (CERRAR) ###
PUT {{baseUrl}}/tiendas/1/estado
Content-Type: {{contentType}}

{
    "abierta": false
}

### 20. VERIFICAR TIENDA CERRADA ###
GET {{baseUrl}}/tiendas
Content-Type: {{contentType}}

### 21. INTENTAR CREAR PEDIDO EN TIENDA CERRADA (DEBE FALLAR) ###
POST {{baseUrl}}/pedidos
Content-Type: {{contentType}}

{
    "usuarioId": 1,
    "tiendaId": 1,
    "productos": [
        {
            "productoId": 1,
            "cantidad": 1
        }
    ],
    "direccionEntrega": "Calle 123 #45-67",
    "metodoPago": "efectivo"
}

### 22. ABRIR TIENDA NUEVAMENTE ###
PUT {{baseUrl}}/tiendas/1/estado
Content-Type: {{contentType}}

{
    "abierta": true
}

### 23. VERIFICAR ESTADOS ACTUALIZADOS ###
GET {{baseUrl}}/pedidos
Content-Type: {{contentType}}

### 24. VERIFICAR ESTADÍSTICAS FINALES ###
GET {{baseUrl}}/stats
Content-Type: {{contentType}}

### 25. PRUEBA DE ERROR - Ruta no encontrada ###
GET {{baseUrl}}/ruta-inexistente
Content-Type: {{contentType}}

### 26. PRUEBA DE ERROR - Login sin campos ###
POST {{baseUrl}}/usuarios/login
Content-Type: {{contentType}}

{
    "username": ""
}

### 27. PRUEBA DE ERROR - Producto sin campos obligatorios ###
POST {{baseUrl}}/tiendas/1/productos
Content-Type: {{contentType}}

{
    "nombre": "Producto sin precio"
}

### 28. PRUEBA DE ERROR - Pedido sin campos obligatorios ###
POST {{baseUrl}}/pedidos
Content-Type: {{contentType}}

{
    "usuarioId": 1
}

### 29. PRUEBA DE ERROR - Actualizar pedido inexistente ###
PUT {{baseUrl}}/pedidos/999
Content-Type: {{contentType}}

{
    "estado": "aceptado"
}

### 30. PRUEBA DE ERROR - Cambiar estado de tienda inexistente ###
PUT {{baseUrl}}/tiendas/999/estado
Content-Type: {{contentType}}

{
    "abierta": false
}

### 31. PRUEBA DE ERROR - Estado de tienda inválido ###
PUT {{baseUrl}}/tiendas/1/estado
Content-Type: {{contentType}}

{
    "abierta": "no_es_booleano"
}

### 32. PRUEBA - Obtener pedidos con filtros ###
GET {{baseUrl}}/pedidos?estado=pendiente
Content-Type: {{contentType}}

### 33. PRUEBA - Obtener pedidos por usuario ###
GET {{baseUrl}}/pedidos?usuarioId=1
Content-Type: {{contentType}}

### 34. PRUEBA - Obtener pedidos por tienda ###
GET {{baseUrl}}/pedidos?tiendaId=1
Content-Type: {{contentType}}

### 35. PRUEBA FINAL - Verificar estadísticas completas ###
GET {{baseUrl}}/stats
Content-Type: {{contentType}}
